{
  "hosting": {
    "public": ".output/public",
    "cleanUrls": true,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "/_nuxt/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "/tree.json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] }
    ]
  }
}
